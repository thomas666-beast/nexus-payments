FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w" \
    -o /out/virtualbank ./cmd/virtualbank

FROM gcr.io/distroless/static-debian12:nonroot

COPY --from=builder /out/virtualbank /virtualbank

USER nonroot:nonroot
EXPOSE 7071

ENTRYPOINT ["/virtualbank"]
